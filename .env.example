APP_NAME="Aquafast Treina"
APP_VERSION=1.0.0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SEGURANCA_FORCAR_HTTPS=false

YOUTUBE_API_KEY=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquafast_treina
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=smtp.aquafast.com.br
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="treinamentos@aquafast.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# --- Integracao de video ---------------------------------------------------
# Chave da YouTube Data API v3. Usada para ler titulo e duracao do video ao
# cadastrar uma aula. Sem ela o sistema cai para oEmbed (titulo apenas) e a
# duracao passa a ser digitada manualmente.
YOUTUBE_API_KEY=

# --- Regras de negocio -----------------------------------------------------
# Percentual do video que conclui a aula automaticamente.
TREINA_PERCENTUAL_CONCLUSAO=90
# Intervalo, em segundos, entre os pings de progresso enviados pelo player.
TREINA_INTERVALO_PING=10
# Conta nova entra como 'pendente' (exige aprovacao) ou 'ativo'.
TREINA_APROVACAO_MANUAL=true

# --- Administrador inicial ------------------------------------------------
ADMIN_NOME="Administrador Aquafast"
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=troque-esta-senha

# --- Contas locais de demonstracao ----------------------------------------
# Usada somente pelo CursoDemoSeeder em local/testing.
DEMO_ALUNO_PASSWORD=troque-esta-senha-demo
