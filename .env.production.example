APP_NAME="Universidade Aquafast"
APP_VERSION=1.0.0
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://treinamentos.aquafast.com.br
SEGURANCA_FORCAR_HTTPS=true
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquafast_treina
DB_USERNAME=aquafast_treina
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=universidade@aquafast.com.br
MAIL_FROM_NAME="Universidade Aquafast"

YOUTUBE_API_KEY=
TREINA_PERCENTUAL_CONCLUSAO=90
TREINA_INTERVALO_PING=10
TREINA_LIMITE_COMENTARIOS_MINUTO=10

ADMIN_NOME="Administrador Aquafast"
ADMIN_EMAIL=
ADMIN_PASSWORD=
